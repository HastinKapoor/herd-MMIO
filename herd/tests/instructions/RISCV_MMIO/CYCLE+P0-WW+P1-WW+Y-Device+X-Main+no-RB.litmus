RISCV CYCLE+P0-WW+P1-WW+Y-Device+X-Main+no-RB

(* Generated two-location cycle. Expected observation: Sometimes.
 * Y and X types are P0's view; P1 uses the agent-relative inverse mapping.
 *)
{
x=0; y=0;
0:x6=y; 0:x8=x;
1:x6=x; 1:x8=y;
}

 P0                     | P1 ;
 ori x11,x0,1           | ori x11,x0,2 ;
 sw x11,0(x6) [Device]  | sw x11,0(x6) [Device] ;
 fence o,w              | fence o,w ;
 sw x11,0(x8) [Main]    | sw x11,0(x8) [Main] ;

exists ([x]=2 /\ [y]=1)
