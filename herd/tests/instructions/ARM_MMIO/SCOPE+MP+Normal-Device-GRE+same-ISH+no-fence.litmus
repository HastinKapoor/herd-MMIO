AArch64 SCOPE+MP+Normal-Device-GRE+same-ISH+no-fence

(* CPU-to-CPU scope check over Normal and Device memory.
 * Expected observation: Sometimes.
 * Both PEs use the same memory type for each location.
 *)
{
x=0; y=0;
0:X0=x; 0:X1=y;
1:X0=y; 1:X1=x;
}

 P0                        | P1 ;
 MOV W4,#1                 | LDR W2,[X0] [Device-GRE] ;
 STR W4,[X0] [Normal]      | LDR W3,[X1] [Normal] ;
 STR W4,[X1] [Device-GRE]  |  ;

scopes: (system (outer (inner (pe P0) (pe P1))))

exists (1:X2=1 /\ 1:X3=0)
