AArch64 CYCLE+P0-WW+P1-RW+Y-Device-GRE+X-Normal+min-RB-P0

(* Generated two-location cycle. Expected observation: Never.
 * Y and X types are P0's view; P1 uses the agent-relative inverse mapping.
 *)
{
x=0; y=0;
0:X0=y; 0:X1=x;
1:X0=x; 1:X1=y;
rb0=0;
0:X10=rb0;
}

 P0                         | P1 ;
 MOV W4,#1                  | MOV W4,#2 ;
 STR W4,[X0] [Device-GRE]   | LDR W2,[X0] [Device-GRE] ;
 DMB ISH                    | DMB OSH ;
 LDR W9,[X10] [Device-GRE]  | STR W4,[X1] [Normal] ;
 DMB OSH                    |  ;
 STR W4,[X1] [Normal]       |  ;

scopes: (system (outer (inner (pe P0)) (inner (pe P1))))
regions: x:device0, y:device0, rb0:device0

exists (1:X2=1 /\ [y]=1)
