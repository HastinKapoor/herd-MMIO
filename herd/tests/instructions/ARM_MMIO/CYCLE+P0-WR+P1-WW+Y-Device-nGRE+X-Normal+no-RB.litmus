AArch64 CYCLE+P0-WR+P1-WW+Y-Device-nGRE+X-Normal+no-RB

(* Generated two-location cycle. Expected observation: Sometimes.
 * Y and X types are P0's view; P1 uses the agent-relative inverse mapping.
 *)
{
x=0; y=0;
0:X0=y; 0:X1=x;
1:X0=x; 1:X1=y;
}

 P0                         | P1 ;
 MOV W4,#1                  | MOV W4,#2 ;
 STR W4,[X0] [Device-nGRE]  | STR W4,[X0] [Device-GRE] ;
 DMB OSH                    | DMB OSH ;
 LDR W3,[X1] [Normal]       | STR W4,[X1] [Normal] ;

scopes: (system (outer (inner (pe P0)) (inner (pe P1))))
regions: x:device0, y:device0

exists (0:X3=0 /\ [y]=1)
