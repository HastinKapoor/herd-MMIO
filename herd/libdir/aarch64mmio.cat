(*
 * CPU/MMIO model -- first-principles scaffold.
 *
 * This file deliberately does not include aarch64.cat or aarch64fences.cat.
 * In particular, it does not identify DMB ISH, OSH, and SY through a shared
 * shareability domain.  The architecture supplies the primitive DMB.SY event
 * set; a future access-annotation parser supplies Normal and Device-* sets.
 *)

(* Optional while the per-access memtype syntax is being wired into events. *)
let Normal = try Normal with emptyset
let Device-nGnRnE = try Device-nGnRnE with emptyset
let Device-nGnRE = try Device-nGnRE with emptyset
let Device-nGRE = try Device-nGRE with emptyset
let Device-GRE = try Device-GRE with emptyset
let DMB.OSH = try DMB.OSH with emptyset
let DMB.SY = try DMB.SY with emptyset

(* Generic coherence construction only; this imports no Arm fence or
 * shareability rule.  It defines co and the derived fr relation. *)
include "cos.cat"

(* Shorthands for the memory types in the ordering chart.  nGnRnE and nGnRE
 * have the same ordering entries in all three tables. *)
let device-strong = Device-nGnRnE | Device-nGnRE
let device-non-gre = device-strong | Device-nGRE
let Device = device-non-gre | Device-GRE
let osh-dmb = DMB.OSH | DMB.SY

(* "None" entries: the architecture's peripheral-arrival ordering makes
 * program order visible for pairs of non-reordering Device accesses. *)
let osh-none = [M & device-strong]; po; [M & device-strong]

(* "OB" entries.  OB may ultimately also be supplied by dependencies or
 * acquire/release; this initial model realizes it with an OSH-or-SY DMB. *)
let osh-ob = [M & device-non-gre]; fencerel(osh-dmb); [M & device-non-gre]

(* "BOB" entries from all three tables.  A Device read can be barrier-ordered
 * before a Normal access.  A Device write cannot: its Device-to-Normal cases
 * require the readback path below. *)
let osh-bob =
    [M & Normal]; fencerel(osh-dmb); [M]
  | [R & Device]; fencerel(osh-dmb); [M & Normal]
  | [M & Device]; fencerel(osh-dmb); [M & Device-GRE]
  | [M & Device-GRE]; fencerel(osh-dmb); [M & Device]

(* PCIe readback requires the Device write to be ordered before the Device
 * read; mere program order is not sufficient for a reordering Device type.
 * osh-none supplies bare program order for non-reordering Device types, while
 * osh-ob/osh-bob supply cases ordered by an OSH-or-SY DMB.  The chart assumes
 * both Device accesses target the same peripheral. *)
let osh-readback =
  [W & Device]; (osh-none | osh-ob | osh-bob); [R & Device]

(* Table 2 also applies unchanged to a read followed by a write.  These
 * clauses are stated separately so that the R-to-W case remains explicit as
 * dependency and acquire/release rules are added later. *)
let osh-rw-none = [R & device-strong]; po; [W & device-strong]
let osh-rw-ob = [R & device-non-gre]; fencerel(osh-dmb); [W & device-non-gre]
let osh-rw-bob =
    [R & Normal]; fencerel(osh-dmb); [W & M]
  | [R & Device]; fencerel(osh-dmb); [W & Normal]
  | [R & Device]; fencerel(osh-dmb); [W & Device-GRE]
  | [R & Device-GRE]; fencerel(osh-dmb); [W & Device]

(* All host orderings visible in the outer-shareable domain. *)
let osh-order =
  (osh-none | osh-ob | osh-bob | osh-readback |
   osh-rw-none | osh-rw-ob | osh-rw-bob)+


(* This is the initial preserved-program-order component.  Rules for Device
 * types, dependencies, and narrower fence scopes can be added independently.
 *)
let ppo = osh-order

(* Initial communication axiom.  co and fr are supplied by herd's candidate
 * execution; rfe is the external part of reads-from. *)
let com = rfe | coe | fre
acyclic osh-order | com as osh-consistency
