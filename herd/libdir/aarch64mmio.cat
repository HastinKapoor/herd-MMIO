(*
 * CPU/MMIO model -- first-principles scaffold.
 *
 * This file deliberately does not include aarch64.cat or aarch64fences.cat.
 * It uses the scope hierarchy supplied by aarch64mmio.bell to distinguish
 * ordering visible in an Inner Shareable domain from ordering visible in an
 * Outer Shareable domain.  Access memory types remain event annotations and
 * are independent of the process topology.
 *)

(* Optional while the per-access memtype syntax is being wired into events. *)
let Normal = try Normal with emptyset
let Device-nGnRnE = try Device-nGnRnE with emptyset
let Device-nGnRE = try Device-nGnRE with emptyset
let Device-nGRE = try Device-nGRE with emptyset
let Device-GRE = try Device-GRE with emptyset
let DMB.ISH = try DMB.ISH with emptyset
let DMB.OSH = try DMB.OSH with emptyset
let DMB.SY = try DMB.SY with emptyset

(* Generic coherence construction only; this imports no Arm fence or
 * shareability rule.  It defines co and the derived fr relation. *)
include "cos.cat"

(* Shorthands for the memory types in the ordering chart.  nGnRnE and nGnRE
 * have the same ordering entries in all three tables. *)
let device-strong = Device-nGnRnE | Device-nGnRE
let device-non-gre = device-strong | Device-nGRE
let Device = device-non-gre | Device-GRE
let ish-dmb = DMB.ISH | DMB.OSH | DMB.SY
let osh-dmb = DMB.OSH | DMB.SY
let any-dmb = DMB.ISH | DMB.OSH | DMB.SY

(* The Arm peripheral-ordering rules apply to a single peripheral.  Tests
 * assign every location participating in one CPU/device interaction to the
 * same Bell region.  Keeping the region identity in this relation prevents
 * an ordering for one device from being composed with an access to another. *)
let device0 = tag2events('device0)
let device1 = tag2events('device1)
let device2 = tag2events('device2)
let device3 = tag2events('device3)
let device4 = tag2events('device4)
let device5 = tag2events('device5)
let device6 = tag2events('device6)
let device7 = tag2events('device7)
let same-device =
    device0 * device0 | device1 * device1
  | device2 * device2 | device3 * device3
  | device4 * device4 | device5 * device5
  | device6 * device6 | device7 * device7

(* "None" entries: the architecture's peripheral-arrival ordering makes
 * program order visible for pairs of non-reordering Device accesses. *)
let device-none =
  ([M & device-strong]; po; [M & device-strong]) & same-device

(* OSH-visible entries from the three MMIO ordering tables. *)
let osh-ob =
  ([M & device-non-gre]; fencerel(osh-dmb); [M & device-non-gre]) & same-device
let osh-bob =
  (  [M & Normal]; fencerel(osh-dmb); [M]
   | [R & Device]; fencerel(osh-dmb); [M & Normal]
   | [M & Device]; fencerel(osh-dmb); [M & Device-GRE]
   | [M & Device-GRE]; fencerel(osh-dmb); [M & Device]
  ) & same-device

let osh-rw-ob =
  ([R & device-non-gre]; fencerel(osh-dmb); [W & device-non-gre]) & same-device
let osh-rw-bob =
  (  [R & Normal]; fencerel(osh-dmb); [W & M]
   | [R & Device]; fencerel(osh-dmb); [W & Normal]
   | [R & Device]; fencerel(osh-dmb); [W & Device-GRE]
   | [R & Device-GRE]; fencerel(osh-dmb); [W & Device]
  ) & same-device

(* ISH-visible entries have the same access-class restrictions, but an ISH,
 * OSH, or SY DMB can supply the barrier ordering.  Stronger domains are also
 * visible to observers in the issuing PE's Inner Shareable domain. *)
let ish-ob =
  ([M & device-non-gre]; fencerel(ish-dmb); [M & device-non-gre]) & same-device
let ish-bob =
  (  [M & Normal]; fencerel(ish-dmb); [M]
   | [R & Device]; fencerel(ish-dmb); [M & Normal]
   | [W & Device]; fencerel(ish-dmb); [M & Normal]
   | [M & Device]; fencerel(ish-dmb); [M & Device-GRE]
   | [M & Device-GRE]; fencerel(ish-dmb); [M & Device]
  ) & same-device
let ish-rw-ob =
  ([R & device-non-gre]; fencerel(ish-dmb); [W & device-non-gre]) & same-device
let ish-rw-bob =
  (  [R & Normal]; fencerel(ish-dmb); [W & M]
   | [R & Device]; fencerel(ish-dmb); [W & Normal]
   | [R & Device]; fencerel(ish-dmb); [W & Device-GRE]
   | [R & Device-GRE]; fencerel(ish-dmb); [W & Device]
  ) & same-device

(* A PCIe readback requires the Device write to be ordered before the Device
 * read.  Program order supplies this for non-reordering Device types.  For a
 * reordering Device type, any DMB orders accesses reaching the same
 * peripheral, independently of the DMB observer domain.  The same-device
 * intersection checks the Bell device regions; tests must still choose a
 * register whose read actually flushes the relevant posted-write path. *)
let device-readback =
  (  [W & Device]; device-none; [R & Device]
   | [W & Device]; fencerel(any-dmb); [R & Device]
  ) & same-device

(* All preserved program order visible in each shareability domain. *)
let ish-order =
  (device-none | ish-ob | ish-bob | device-readback |
   ish-rw-ob | ish-rw-bob)+

let osh-order =
  (device-none | osh-ob | osh-bob | device-readback |
   osh-rw-ob | osh-rw-bob)+

(* Communication participates only when both endpoints are in the same
 * instance of the domain being checked.  Intersecting the complete cycle
 * relation with tag2scope also prevents ISH ordering from constraining an
 * observer in a different Inner Shareable domain. *)
let com = rfe | coe | fre
acyclic ((ish-order | com) & tag2scope('inner)) as ish-consistency
acyclic ((osh-order | com) & tag2scope('outer)) as osh-consistency
